# Development only. Set NODE_ENV=production for deployed environments.
NODE_ENV=development
PORT=3001
# Comma-separated exact origins. Do not use * for an authenticated API.
FRONTEND_ORIGINS=http://localhost:3000
# Generate a random secret of at least 32 characters; never commit the real value.
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Short access-token validity in seconds (recommended: 900).
JWT_ACCESS_TTL_SECONDS=900
# Swagger is available outside production at this path.
SWAGGER_PATH=api/docs
# Local PostgreSQL URL. Replace USER and PASSWORD in your untracked .env.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ayucare_db?schema=public
# Optional synthetic development staff seed. Use a unique random password locally.
DEV_SEED_STAFF_EMAIL=dev.doctor@ayucare.test
DEV_SEED_STAFF_PASSWORD=
DEV_SEED_STAFF_ROLE=DOCTOR
